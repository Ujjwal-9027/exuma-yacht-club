MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority"
MONGODB_DB="exuma_yacht_club"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-session-secret"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_ENVIRONMENT="sandbox"
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user@example.com"
SMTP_PASSWORD="your-smtp-app-password"
EMAIL_FROM="Exuma Yacht Club <orders@example.com>"
NOTIFY_EMAIL="notifications@example.com"
INQUIRY_NOTIFICATION_EMAIL="your-inquiry-notification@example.com"
ORDER_NOTIFICATION_EMAIL="your-order-notification@example.com"

